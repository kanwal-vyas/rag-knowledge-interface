# HH Goa 2026 Task 2 — environment configuration template.
# Copy to .env and fill in real values locally. Never commit .env.

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000  # backend API URL

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Demo mode — load prebuilt BM25 index from artifacts/demo/
# Run: python -m scripts.prepare_demo_index
# ---------------------------------------------------------------------------
DEMO_MODE=false                  # true = load prebuilt demo index at startup
DEMO_INDEX_PATH=artifacts/demo/bm25_index.json
DEMO_PASSAGE_STORE_PATH=artifacts/demo/passage_store.json

# ---------------------------------------------------------------------------
# Vector database — Qdrant (Audit §5/§7)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# ---------------------------------------------------------------------------
# Embedding — bge-m3 (Audit §4/§7)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu             # cpu | cuda
EMBEDDING_ENDPOINT_URL=
HF_EMBEDDING_DEVICE=             # override for HuggingFace device selection

# ---------------------------------------------------------------------------
# STT — Sarvam AI Saaras v3
# Required for voice queries. Get key at https://dashboard.sarvam.ai
# ---------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here

# ---------------------------------------------------------------------------
# Generation — Google Gemini (primary) or DeepSeek (fallback)
# Get Gemini key at https://aistudio.google.com/apikey
# Without any key, StubGenerator is used (returns canned answers).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash  # or gemini-3.5-flash-lite

# DeepSeek fallback (optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Legacy field names (for backward compatibility with pydantic-settings):
STT_PROVIDER=sarvam
STT_API_KEY=your_stt_api_key_here
GENERATION_PROVIDER=
GENERATION_API_KEY=
GENERATION_MODEL_NAME=
